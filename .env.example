# Saint Helen Liturgy: environment variables
# Copy to .env.local for development. Never commit .env.local.
# Vercel: Project -> Settings -> Environment Variables, then redeploy.

# ---- Required ----

# Postgres. Neon (set by the Vercel Neon integration) uses the serverless HTTP driver;
# any other Postgres URL uses node-postgres, so a local Postgres works for development.
DATABASE_URL=postgres://postgres@localhost:5432/liturgy

# Signs the MFA ticket cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Public URL with no trailing slash. Used in every text and email link, the Microsoft
# redirect URI, and Twilio webhook signature checks. Must match what Twilio and Entra are told.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Recommended in production ----

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on cron calls.
# If unset, the cron routes are open to anyone. Generate with: openssl rand -base64 32
CRON_SECRET=

PARISH_NAME=Saint Helen
PARISH_TIMEZONE=America/New_York

# ---- Twilio (texted codes, reminders, YES/NO replies) ----
# Set either TWILIO_MESSAGING_SERVICE_SID (preferred, what 10DLC wants) or TWILIO_FROM_NUMBER.
# Point the number's inbound webhook (HTTP POST) at $NEXT_PUBLIC_APP_URL/api/twilio/inbound.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ---- Resend (email codes, invites, reminders) ----
RESEND_API_KEY=
EMAIL_FROM="Saint Helen Liturgy <liturgy@sending.sainthelen.org>"
# Where replies land. Must be a real mailbox.
EMAIL_REPLY_TO=liturgy@sainthelen.org

# ---- Anthropic (reads the presider schedule PDF on Admin -> Schedule -> Presider schedule) ----
ANTHROPIC_API_KEY=

# ---- Microsoft 365 staff sign-in (optional) ----
# Entra app registration, redirect URI (Web): $NEXT_PUBLIC_APP_URL/api/auth/microsoft/callback
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---- Development only ----
# With no Twilio/Resend keys, print codes and invite links to the server log instead of sending.
# Never leave this on in production; it writes codes to the function logs.
DEV_OTP_ECHO=true

# Force the Neon HTTP driver for a non-neon.tech URL (rarely needed).
# DB_DRIVER=neon

# ---- Seed script only (npm run seed) ----
# ADMIN_EMAIL=matthew@sainthelen.org
# ADMIN_PHONE=9085550100
# ADMIN_PASSWORD=
# ADMIN_FIRST=Matthew
# ADMIN_LAST=Boyle
